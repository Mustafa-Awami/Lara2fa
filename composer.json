{
    "name": "mustafa-awami/lara2fa",
    "description": "Laravel 2FA package with TOTP, Email OTP, Passkeys & Recovery Codes.",
    "keywords": [
        "laravel",
        "2fa",
        "two-factor",
        "two-factor authentication",
        "authentication",
        "auth",
        "security",
        "otp",
        "email otp",
        "webauthn",
        "passkeys",
        "authenticator app",
        "google authenticator",
        "mfa",
        "multi factor authentication",
        "laravel security",
        "laravel package",
        "tfa",
        "login security",
        "auth package",
        "laravel plugin",
        "laravel addon",
        "otp verification",
        "two-step verification",
        "totp",
        "u2f",
        "fido2"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MustafaAwami\\Lara2fa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MustafaAwami\\Lara2fa\\Tests\\": "tests/",
            "App\\": "workbench/app/",
            "Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "authors": [
        {
            "name": "Mustafa Al-Awami",
            "email": "mustafa.awami1@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "laravel/fortify": "^1.32",
        "web-auth/webauthn-lib": "5.2"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "orchestra/testbench": "^10.7",
        "phpunit/phpunit": "^10.4|^11.3"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MustafaAwami\\Lara2fa\\Lara2faServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    }
}
